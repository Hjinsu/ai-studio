# AI Studio 전용 환경변수는 모두 AI_STUDIO_ 접두사를 사용한다 (ADR-013). 다른 프로젝트의 DB_* 등은 사용하지 않는다.
# .env로 복사해 로컬 값만 입력한다. .env는 Git에 포함하지 않는다.
AI_STUDIO_ENV=local
AI_STUDIO_DB_URL=jdbc:mariadb://localhost:3306/ai_studio
AI_STUDIO_DB_USER=ai_studio
AI_STUDIO_DB_PASSWORD=
# prod profile 전용: Flyway migration 계정(앱 계정과 분리, ADR-025)
AI_STUDIO_DB_MIGRATION_USER=
AI_STUDIO_DB_MIGRATION_PASSWORD=
AI_STUDIO_STORAGE_ROOT=./storage
AI_STUDIO_FFMPEG_BIN=ffmpeg
AI_STUDIO_FFPROBE_BIN=ffprobe
AI_STUDIO_LIVE_PROVIDER_ENABLED=false
AI_STUDIO_YOUTUBE_UPLOAD_ENABLED=false
AI_STUDIO_YOUTUBE_CLIENT_ID=
AI_STUDIO_YOUTUBE_CLIENT_SECRET=
AI_STUDIO_ENCRYPTION_KEY=
AI_STUDIO_OPENAI_API_KEY=
# 프론트 Vite 개발 서버 프록시 대상 (선택)
AI_STUDIO_BACKEND_URL=http://127.0.0.1:8080
